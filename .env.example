# Copie este arquivo para .env e ajuste os valores para o seu ambiente.

# Conexão com o MongoDB (obrigatório)
MONGO_URL=mongodb://localhost:27017

# Nome do banco de dados
DB_NAME=proposal_generator

# URL pública usada nos links compartilháveis das propostas
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Origens permitidas para CORS (use o domínio do seu deploy em produção)
CORS_ORIGINS=*
